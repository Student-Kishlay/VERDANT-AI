# ── InsForge (real backend — used once this project is migrated off the local mock) ──
INSFORGE_PROJECT_URL=
INSFORGE_ANON_KEY=          # safe for frontend
INSFORGE_SERVICE_ROLE_KEY=  # edge functions only, NEVER in frontend code

# ── AI provider (choose one; ai-chat function reads AI_PROVIDER to decide) ──
# Local mock backend note: anything other than AI_PROVIDER=groq with a real
# GROQ_API_KEY falls back to the built-in mock provider (server/llm/mock-provider.js)
# — a deterministic, data-grounded responder that needs no credentials. The
# real InsForge AI Gateway path doesn't exist yet (no InsForge project connected).
AI_PROVIDER=insforge_gateway   # or: groq
GROQ_API_KEY=                  # only required if AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# ── App config ──
DEFAULT_SHARE_LINK_EXPIRY_DAYS=7
ANOMALY_CONTAMINATION_RATE=0.05
CHART_GROUNDING_THRESHOLD=0.6

# ── Upload & abuse limits ──
MAX_UPLOAD_FILE_SIZE_MB=25
MAX_UPLOAD_ROW_COUNT=200000
AI_CHAT_MAX_MESSAGES_PER_WORKSPACE_PER_HOUR=60
AI_CHAT_MAX_CONTEXT_TOKENS=4000

# ── Local mock backend only (server/) — not part of the InsForge spec, remove when migrating ──
PORT=5175
JWT_SECRET=change-this-to-a-long-random-string-in-any-real-deployment
MOCK_MODE=true
